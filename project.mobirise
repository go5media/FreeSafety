                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              },
              ".mbr-section-btn": {
                "margin-bottom": "-9.6px"
              }
            },
            ".image-wrapper": {
              "margin-top": "50px",
              "@media (max-width: 992px)": {
