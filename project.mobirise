          "_name": "form02",
          "_sourceTheme": "humanitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form02 humanitym5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label BG\" value=\"#deeff8\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Form</header>\n        <input type=\"color\" title=\"Input Color\" value=\"#8b8b8a\" name=\"inputColor\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#ffffff\" name=\"border\" selected>\n        <input type=\"color\" title=\"BG\" value=\"#ffffff\" name=\"formBg\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background6.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#edefeb\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-4.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#116e99\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                    <div class=\"label-wrapper\">\n                        <p class=\"mbr-label mbr-fonts-style card-wrap middle-radius\" data-app-selector=\".mbr-label, .label-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\">\n                            <b>Contact</b>\n                        </p>\n                    </div>\n                    <div class=\"title-wrap\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrap, .list-wrapper\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                            <b>Contact Us Free!</b></h2>\n                    </div>\n                    <div class=\"text-wrapper\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                            Whether you would like to donate, volunteer, partner with us, or learn more about our\n                            initiatives, we would love to hear from you.\n                        </p>\n                    </div>\n                </div>\n                <div mbr-form class=\"mbr-form form-wrap card-wrap\">\n                    <!--Formbuilder Form-->\n                    <form action=\"scanlon1000@gmail.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"scanlon1000@gmail.com\">\n                        <div class=\"row\">\n                            <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling\n                                out the form!</div>\n                            <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some\n                                problem!\n                            </div>\n                        </div>\n                        <div class=\"dragArea row\">\n                            <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"name\">\n                                <label mbr-text mbr-theme-style=\"display-4\" for=\"name\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Full Name</label>\n                                <input type=\"text\" name=\"name\" placeholder=\"John Smith\" data-form-field=\"name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                            </div>\n                            <div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email1\">\n                                <label mbr-text mbr-theme-style=\"display-4\" for=\"email1\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Email</label>\n                                <input type=\"email\" name=\"email1\" placeholder=\"my.email@hostmail.uscn.org.uk\" data-form-field=\"email1\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                            </div>\n                            <div data-for=\"text\" class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\">\n                                <label mbr-text mbr-theme-style=\"display-4\" for=\"text\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Phone</label>\n                                <input type=\"text\" name=\"text\" placeholder=\"07500 123456\" data-form-field=\"text\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                            </div>\n                            <div data-for=\"text1\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" hidden=\"hidden\">\n                                <label mbr-text mbr-theme-style=\"display-4\" for=\"text1\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\" hidden=\"hidden\">Company</label>\n                                <input type=\"text\" name=\"text1\" placeholder=\"Charity Foundation\" data-form-field=\"text1\" mbr-theme-style=\"display-4\" class=\"form-control\" value hidden=\"hidden\">\n                            </div>\n                            <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"textarea\">\n                                <label mbr-text mbr-theme-style=\"display-4\" for=\"textarea\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Message</label>\n                                <textarea name=\"textarea\" placeholder=\"Your message...\" data-form-field=\"textarea\" mbr-theme-style=\"display-4\" class=\"form-control\"></textarea>\n                            </div>\n                            <div mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-md-auto col mbr-section-btn\"><a type=\"submit\" class=\"btn btn-black-outline\" data-app-placeholder=\"Type Text\">Send\n                                Message </a></div>\n                        </div>\n                    </form><!--Formbuilder Form-->\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
