                  "background-color": "transparent",
                  "color": "@activeColor !important",
                  "&::after": {
                    "color": "inherit !important"
                  },
                  "&::before": {
                    "background-color": "@activeColor"
                  }
                }
              },
              ".nav-link.show": {
                "&::after": {
                  "transform": "rotate(180deg)"
                }
              },
              ".dropdown-menu": {
                "background-color": "transparent !important",
                "&:hover": {
                  "background-color": "transparent !important"
                }
              }
            },
