                    "@media (max-width: 1440px)": {
                      "width": "80%"
                    },
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              },
              ".mbr-section-btn": {
                "margin-bottom": "-9.6px"
              }
            },
            ".image-wrapper": {
