                    "display": "inline-block",
                    "width": "60%",
                    "margin-bottom": "0",
                    "@media (max-width: 1440px)": {
                      "width": "80%"
                    },
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                },
                ".text-wrapper": {
                  "position": "relative",
                  "z-index": "1",
                  "margin-top": "20px",
                  ".mbr-text": {
