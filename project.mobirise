              "color": "#9ba9c4"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#ffffff"
            },
            ".item-title": {
              "color": "#d1d4e3"
            },
            ".mbr-label, .label-wrapper": {
              "color": "#ffffff"
            }
          },
          "_name": "contacts01",
          "_sourceTheme": "syncm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"contacts01 syncm5\" group=\"Contacts\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"12\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#242a3c\" name=\"labelBorder\" condition=\"showLabel || showIcon\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Contacts</header>\n        <input type=\"color\" title=\"Icon BG\" value=\"#000000\" name=\"iconBg\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Gradient 1\" value=\"#ffcd7d\" name=\"gradient_1\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Gradient 2\" value=\"#0175ff\" name=\"gradient_2\" condition=\"showIcon\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/syncm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/syncm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-11\">\n                <div class=\"content-wrapper\">\n                    <div class=\"row content-wrap justify-content-between\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-6 card\">\n                            <div class=\"title-wrapper\">\n                                <div class=\"label-wrapper\" mbr-if=\"showLabel || showIcon\">\n                                    <div class=\"label-wrap\">\n                                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                            <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-link mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                        </div>\n                                        <p class=\"mbr-label mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".mbr-label, .label-wrapper\">UK SAFETY CAMERA NETWROK Ltd</p>\n                                    </div>\n                                </div>\n                                <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Contact The People Making Communities Safer</h2>\n                                <div class=\"text-wrapper\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                        Have questions, need support, or want to learn more about our CCTV network? Our team\n                                        is ready to assist you.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-black\" href=\"contact.html#form02-3c\" data-app-placeholder=\"Type Text\">\n                                    Contact Us\n                                </a></div>\n                        </div>\n                        <div class=\"col-12 col-lg-5 card\">\n                            <div class=\"items-wrapper\">\n                                <div class=\"items-wrap\">\n                                    <div class=\"item features-without-image\">\n                                        <div class=\"item-wrapper little-radius\">\n                                            <div class=\"icon-wrapper\">\n                                                <div class=\"icon-wrap card-wrap\">\n                                                <span mbr-icon class=\"card-icons card-wrap mbr-iconfont mobi-mbri-mobile-2 mobi-mbri\" data-app-selector=\".card-icons\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                                </div>\n                                            </div>\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .items-wrapper\"><a href=\"tel:+448082801223\" class=\"text-white\">0808 280 1223</a></h4>\n                                        </div>\n                                    </div><div class=\"item features-without-image\">\n                                        <div class=\"item-wrapper little-radius\">\n                                            <div class=\"icon-wrapper\">\n                                                <div class=\"icon-wrap card-wrap\">\n                                                <span mbr-icon class=\"card-icons card-wrap mbr-iconfont mobi-mbri-mobile-2 mobi-mbri\" data-app-selector=\".card-icons\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                                </div>\n                                            </div>\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .items-wrapper\"><a href=\"tel:+443305201223\" class=\"text-white\">0330 520 1223</a></h4>\n                                        </div>\n                                    </div>\n                                    <div class=\"item features-without-image\">\n                                        <div class=\"item-wrapper little-radius\">\n                                            <div class=\"icon-wrapper\">\n                                                <div class=\"icon-wrap card-wrap\">\n                                            <span mbr-icon class=\"card-icons card-wrap mbr-iconfont mobi-mbri-letter mobi-mbri\" data-app-selector=\".card-icons\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                                </div>\n                                            </div>\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .items-wrapper\"><a href=\"mailto:info@uscn.org.uk\" class=\"text-white\">info@uscn.org.uk</a></h4>\n                                        </div>\n                                    </div>\n                                    \n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vqQsIoX5kW",
