                  },
                  ".form-check": {
                    "padding-left": "2.1em",
                    ".form-check-input": {
                      "background-color": "@inputColor",
                      "border-color": "@inputColor"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "width": "100%",
                  "margin-top": "10px",
                  ".btn": {
                    "margin-bottom": "0",
                    "margin-right": "0",
                    "margin-top": "0",
                    "min-height": "auto",
                    "width": "100%"
                  }
                }
