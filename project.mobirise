                "justify-content": "flex-end",
                "margin": "0"
              }
            },
            ".nav-item": {
              "padding": "0",
              "margin": "0",
              ".nav-link": {
                "padding": "10px 20px !important",
                "margin": "0 10px !important",
                "transition": "all 0.3s ease-in-out",
                "font-weight": "400",
                "@media (max-width: 992px)": {
                  "margin": "0 !important"
                },
                "&::after": {
                  "color": "inherit !important",
                  "transform": "rotate(0)",
                  "transition": ".3s"
                },
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "left": "0",
                  "width": "12px",
                  "height": "12px",
                  "border": "1px solid @activeColor",
                  "transition": ".3s all ease",
